@startuml Diagrama_ER_GestionDocumental
title Diagrama Entidad-Relación - Módulo Gestión Documental\nÉpica: Gestión Documental (Conjunto residencial)

skinparam linetype ortho

entity "USUARIO" as usuario {
  * idUsuario : INT <<PK>>
  --
  nombre : VARCHAR(100)
  rol : VARCHAR(50)
  correo : VARCHAR(100)
  estado : BOOLEAN
}

entity "CATEGORIA_DOCUMENTO" as categoria {
  * idCategoria : INT <<PK>>
  --
  nombre : VARCHAR(50)
  descripcion : VARCHAR(200)
}

entity "TIPO_ARCHIVO_PERMITIDO" as tipoArchivo {
  * idTipoArchivo : INT <<PK>>
  --
  extension : VARCHAR(10)
  descripcion : VARCHAR(100)
  activo : BOOLEAN
}

entity "DOCUMENTO" as documento {
  * idDocumento : INT <<PK>>
  --
  nombreArchivo : VARCHAR(150)
  rutaArchivo : VARCHAR(250)
  extension : VARCHAR(10)
  tamanoKB : DECIMAL(10,2)
  fechaDocumento : DATE
  fechaCarga : DATETIME
  descripcion : VARCHAR(300)
  # idCategoria : INT <<FK>>
  # idUsuarioCarga : INT <<FK>>
}

entity "AUDITORIA_DOCUMENTO" as auditoria {
  * idAuditoria : INT <<PK>>
  --
  # idDocumento : INT <<FK>>
  # idUsuario : INT <<FK>>
  accion : VARCHAR(50)
  fechaAccion : DATETIME
  detalle : VARCHAR(200)
}

usuario       ||--o{ documento  : "sube (idUsuarioCarga)"
categoria     ||--o{ documento  : "clasifica"
documento     ||--o{ auditoria  : "registra historial"
usuario       ||--o{ auditoria  : "ejecuta acción"
tipoArchivo   }o..o{ documento  : "valida extensión"

note right of documento
  Los campos categoría y fecha
  son obligatorios al momento
  de la carga (criterio de
  aceptación 1).
end note

note right of tipoArchivo
  Se valida la extensión del
  archivo contra este catálogo
  antes de permitir la carga
  (criterio de aceptación 2).
end note

note bottom of auditoria
  Permite conocer quién subió
  el documento y cuándo
  (criterio de aceptación 3).
end note

@enduml
